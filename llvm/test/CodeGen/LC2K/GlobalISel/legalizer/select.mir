# RUN: llc -march=lc2k -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s
--- |
  define void @f() { ret void }
...
---
name:            f
legalized:       false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
  - { id: 3, class: _ }
body:             |
  bb.0:
    liveins: $r1, $r2

    ; CHECK-LABEL: name: f
    ; CHECK: legalized: true
    ; CHECK: %2:_(s1) = G_ICMP intpred(eq), %0(s32), %1
    ; CHECK-NEXT: %3:_(s32) = G_SELECT %2(s1), %0, %1
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s1) = G_ICMP intpred(eq), %0(s32), %1
    %3:_(s32) = G_SELECT %2(s1), %0, %1
    $r1 = COPY %3(s32)
    $r0 = JALR killed $r15, implicit $r1
...
