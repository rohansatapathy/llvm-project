    %2:_(s32), %3:_(s1) = G_SSUBE %0, %1, %4
    $r1 = COPY %2(s32)
    G_BRCOND %3(s1), %bb.1
    G_BR %bb.2
  bb.1:
    $r0 = JALR killed $r15
  bb.2:
    $r0 = JALR killed $r15
...
