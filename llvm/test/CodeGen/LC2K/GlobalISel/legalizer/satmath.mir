legalized:       false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
body:             |
  bb.0:
    liveins: $r1, $r2

    ; CHECK-LABEL: name: ssubsat
    ; CHECK: legalized: true
    ; CHECK: G_SUB
    ; CHECK: ADDR_ES &__lc2k_slt
    ; CHECK: G_SELECT
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s32) = G_SSUBSAT %0, %1
    $r1 = COPY %2(s32)
    $r0 = JALR killed $r15, implicit $r1
...
---
name:            usubsat
legalized:       false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
body:             |
  bb.0:
    liveins: $r1, $r2

    ; CHECK-LABEL: name: usubsat
    ; CHECK: legalized: true
    ; CHECK: G_SUB
    ; CHECK: ADDR_ES &__lc2k_ult
    ; CHECK: G_SELECT
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s32) = G_USUBSAT %0, %1
    $r1 = COPY %2(s32)
    $r0 = JALR killed $r15, implicit $r1
...
---
name:            sshlsat
legalized:       false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
