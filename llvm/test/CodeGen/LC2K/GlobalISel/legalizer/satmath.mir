  bb.0:
    liveins: $r1, $r2

    ; CHECK-LABEL: name: sshlsat
    ; CHECK: legalized: true
    ; CHECK: ADDR_ES &__lc2k_shl
    ; CHECK: ADDR_ES &__lc2k_ashr
    ; CHECK: G_SELECT
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s32) = G_SSHLSAT %0, %1
