# RUN: llc -march=lc2k -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s
--- |
  define void @f() { ret void }
...
---
name:            f
legalized:       false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
body:             |
  ; CHECK-LABEL: name: f
  ; CHECK: legalized: true
  bb.0:
    successors: %bb.1

    ; CHECK: %0:_(s32) = G_IMPLICIT_DEF
    ; CHECK: G_BR %bb.1
    %0:_(s32) = G_IMPLICIT_DEF
    G_BR %bb.1

  bb.1:
    successors: %bb.1

    ; CHECK: %2:_(s32) = G_PHI %0(s32), %bb.0, %1(s32), %bb.1
    ; CHECK: %1:_(s32) = G_ADD %2, %2
    ; CHECK: G_BR %bb.1
    %2:_(s32) = G_PHI %0(s32), %bb.0, %1(s32), %bb.1
    %1:_(s32) = G_ADD %2, %2
    G_BR %bb.1
...
