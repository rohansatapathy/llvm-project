# RUN: llc -march=lc2k -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s
--- |
  define void @slt() { ret void }
  define void @sgt() { ret void }
  define void @sle() { ret void }
  define void @sge() { ret void }
  define void @ult() { ret void }
  define void @ugt() { ret void }
  define void @ule() { ret void }
  define void @uge() { ret void }
...
---
name:            slt
legalized:       false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2

    ; CHECK-LABEL: name: slt
    ; not swapped, not negated
    ; CHECK: ADDR_ES &__lc2k_slt
    ; CHECK: $r1 = COPY %0(s32)
    ; CHECK: $r2 = COPY %1(s32)
    ; CHECK-NOT: G_XOR
    ; CHECK: G_TRUNC
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s1) = G_ICMP intpred(slt), %0(s32), %1
    G_BRCOND %2(s1), %bb.1
    G_BR %bb.2
  bb.1:
    $r0 = JALR killed $r15
  bb.2:
    $r0 = JALR killed $r15
...
---
name:            sgt
legalized:       false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2

    ; CHECK-LABEL: name: sgt
    ; swapped (calls slt(b, a)), not negated
    ; CHECK: ADDR_ES &__lc2k_slt
    ; CHECK: $r1 = COPY %1(s32)
    ; CHECK: $r2 = COPY %0(s32)
    ; CHECK-NOT: G_XOR
    ; CHECK: G_TRUNC
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s1) = G_ICMP intpred(sgt), %0(s32), %1
    G_BRCOND %2(s1), %bb.1
    G_BR %bb.2
  bb.1:
    $r0 = JALR killed $r15
  bb.2:
    $r0 = JALR killed $r15
...
