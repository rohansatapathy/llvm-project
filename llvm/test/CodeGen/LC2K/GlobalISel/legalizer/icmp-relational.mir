    ; CHECK-LABEL: name: sge
    ; not swapped (calls slt(a, b)), negated
    ; CHECK: ADDR_ES &__lc2k_slt
    ; CHECK: $r1 = COPY %0(s32)
    ; CHECK: $r2 = COPY %1(s32)
    ; CHECK: G_XOR
    ; CHECK: G_TRUNC
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s1) = G_ICMP intpred(sge), %0(s32), %1
    G_BRCOND %2(s1), %bb.1
