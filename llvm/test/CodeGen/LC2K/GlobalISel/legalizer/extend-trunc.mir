# RUN: llc -march=lc2k -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s

# G_TRUNC {s1,s32}, and G_ZEXT/G_SEXT/G_ANYEXT {s32,s1} (see the s1-material-
# ization comment in LC2KLegalizerInfo.cpp) are all plain .legalFor rules with
# no custom rewrite: legalization should leave each instruction exactly as it
# is and defer the real lowering to instruction selection.

--- |
  define void @trunc() { ret void }
  define void @zext() { ret void }
  define void @sext() { ret void }
  define void @anyext() { ret void }
...
---
name:            trunc
legalized:       false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1

    ; CHECK-LABEL: name: trunc
    ; CHECK: legalized: true
    ; CHECK: %1:_(s1) = G_TRUNC %0(s32)
    ; CHECK: G_BRCOND %1(s1), %bb.1
    %0:_(s32) = COPY $r1
    %1:_(s1) = G_TRUNC %0(s32)
    G_BRCOND %1(s1), %bb.1
    G_BR %bb.2
  bb.1:
    $r0 = JALR killed $r15
  bb.2:
    $r0 = JALR killed $r15
...
---
name:            zext
legalized:       false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
  - { id: 3, class: _ }
body:             |
  bb.0:
    liveins: $r1, $r2

    ; CHECK-LABEL: name: zext
    ; CHECK: legalized: true
    ; CHECK: %3:_(s32) = G_ZEXT %2(s1)
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s1) = G_ICMP intpred(eq), %0(s32), %1
    %3:_(s32) = G_ZEXT %2(s1)
    $r1 = COPY %3(s32)
    $r0 = JALR killed $r15, implicit $r1
...
---
name:            sext
legalized:       false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
  - { id: 3, class: _ }
body:             |
  bb.0:
    liveins: $r1, $r2

    ; CHECK-LABEL: name: sext
    ; CHECK: legalized: true
    ; CHECK: %3:_(s32) = G_SEXT %2(s1)
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s1) = G_ICMP intpred(eq), %0(s32), %1
    %3:_(s32) = G_SEXT %2(s1)
    $r1 = COPY %3(s32)
    $r0 = JALR killed $r15, implicit $r1
...
---
name:            anyext
legalized:       false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
  - { id: 3, class: _ }
body:             |
  bb.0:
    liveins: $r1, $r2

    ; CHECK-LABEL: name: anyext
    ; CHECK: legalized: true
    ; CHECK: %3:_(s32) = G_ANYEXT %2(s1)
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s1) = G_ICMP intpred(eq), %0(s32), %1
    %3:_(s32) = G_ANYEXT %2(s1)
    $r1 = COPY %3(s32)
    $r0 = JALR killed $r15, implicit $r1
...
