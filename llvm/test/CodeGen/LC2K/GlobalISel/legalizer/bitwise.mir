# RUN: llc -march=lc2k -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s
--- |
  define void @f() { ret void }
...
---
name:            f
legalized:       false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
  - { id: 3, class: _ }
  - { id: 4, class: _ }
  - { id: 5, class: _ }
  - { id: 6, class: _ }
  - { id: 7, class: _ }
  - { id: 8, class: _ }
body:             |
  bb.0:
    liveins: $r1, $r2

    ; CHECK-LABEL: name: f
    ; CHECK: legalized: true
    ; CHECK: %0:_(s32) = COPY $r1
    ; CHECK: %1:_(s32) = COPY $r2
    ; CHECK: %2:_(s32) = G_SUB %0, %1
    ; CHECK: %3:_(s32) = G_AND %0, %1
    ; CHECK: %4:_(s32) = G_OR %0, %1
    ; CHECK: %5:_(s32) = G_XOR %0, %1
    ; CHECK: %6:_(s32) = G_ADD %2, %3
    ; CHECK: %7:_(s32) = G_ADD %4, %5
    ; CHECK: %8:_(s32) = G_ADD %6, %7
    ; CHECK: $r1 = COPY %8(s32)
    ; CHECK: $r0 = JALR killed $r15, implicit $r1
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s32) = G_SUB %0, %1
    %3:_(s32) = G_AND %0, %1
    %4:_(s32) = G_OR %0, %1
    %5:_(s32) = G_XOR %0, %1
    %6:_(s32) = G_ADD %2, %3
    %7:_(s32) = G_ADD %4, %5
    %8:_(s32) = G_ADD %6, %7
    $r1 = COPY %8(s32)
    $r0 = JALR killed $r15, implicit $r1
...
