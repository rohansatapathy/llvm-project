# RUN: llc -march=lc2k -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s
--- |
  define void @eq() { ret void }
  define void @ne() { ret void }
...
---
name:            eq
legalized:       false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2

    ; CHECK-LABEL: name: eq
    ; CHECK: legalized: true
    ; CHECK: %2:_(s1) = G_ICMP intpred(eq), %0(s32), %1
    ; CHECK-NEXT: G_BRCOND %2(s1), %bb.1
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s1) = G_ICMP intpred(eq), %0(s32), %1
    G_BRCOND %2(s1), %bb.1
    G_BR %bb.2

  bb.1:
    $r0 = JALR killed $r15

  bb.2:
    $r0 = JALR killed $r15
...
---
name:            ne
legalized:       false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r1, $r2

    ; CHECK-LABEL: name: ne
    ; CHECK: %2:_(s1) = G_ICMP intpred(ne), %0(s32), %1
    ; CHECK-NEXT: G_BRCOND %2(s1), %bb.1
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s1) = G_ICMP intpred(ne), %0(s32), %1
    G_BRCOND %2(s1), %bb.1
    G_BR %bb.2

  bb.1:
    $r0 = JALR killed $r15

  bb.2:
    $r0 = JALR killed $r15
...
