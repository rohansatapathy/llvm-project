  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
body:             |
  bb.0:
    liveins: $r1, $r2

    ; CHECK-LABEL: name: ucmp
    ; CHECK: legalized: true
    ; CHECK: ADDR_ES &__lc2k_ult
    ; CHECK: ADDR_ES &__lc2k_ult
    ; CHECK: G_SELECT
    ; CHECK: G_SELECT
