  - { id: 1, class: _ }
  - { id: 2, class: _ }
body:             |
  bb.0:
    liveins: $r1, $r2

    ; CHECK-LABEL: name: umin
    ; CHECK: legalized: true
    ; CHECK: ADDR_ES &__lc2k_ult
    ; CHECK: G_SELECT
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s32) = G_UMIN %0, %1
    $r1 = COPY %2(s32)
    $r0 = JALR killed $r15, implicit $r1
...
---
name:            scmp
legalized:       false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
body:             |
  bb.0:
    liveins: $r1, $r2

    ; CHECK-LABEL: name: scmp
    ; CHECK: legalized: true
    ; CHECK: ADDR_ES &__lc2k_slt
    ; CHECK: ADDR_ES &__lc2k_slt
    ; CHECK: G_SELECT
    ; CHECK: G_SELECT
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s32) = G_SCMP %0, %1
    $r1 = COPY %2(s32)
    $r0 = JALR killed $r15, implicit $r1
...
---
name:            ucmp
legalized:       false
