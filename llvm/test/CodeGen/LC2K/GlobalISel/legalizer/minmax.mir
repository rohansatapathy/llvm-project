---
name:            gabs
legalized:       false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
body:             |
  bb.0:
    liveins: $r1

    ; CHECK-LABEL: name: gabs
    ; CHECK: legalized: true
    ; CHECK: ADDR_ES &__lc2k_ashr
    ; CHECK: G_ADD
    ; CHECK: G_XOR
    %0:_(s32) = COPY $r1
    %1:_(s32) = G_ABS %0
    $r1 = COPY %1(s32)
    $r0 = JALR killed $r15, implicit $r1
...
---
name:            abds
legalized:       false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
body:             |
  bb.0:
    liveins: $r1, $r2

    ; CHECK-LABEL: name: abds
    ; CHECK: legalized: true
    ; CHECK: G_SUB
    ; CHECK: G_SUB
    ; CHECK: ADDR_ES &__lc2k_slt
    ; CHECK: G_SELECT
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
