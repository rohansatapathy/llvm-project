# RUN: llc -march=lc2k -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s
--- |
  define void @f() { ret void }
...
---
name:            f
legalized:       false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
  - { id: 3, class: _ }
  - { id: 4, class: _ }
body:             |
  bb.0:
    liveins: $r1, $r2

    ; CHECK-LABEL: name: f
    ; CHECK: legalized: true
    ; CHECK: %0:_(s32) = COPY $r1
    ; CHECK: %1:_(s32) = COPY $r2
    ; CHECK: %2:_(s32) = G_CONSTANT i32 1
    ; CHECK: %3:_(s32) = G_ADD %0, %1
    ; CHECK: %4:_(s32) = G_ADD %3, %2
    ; CHECK: $r1 = COPY %4(s32)
    ; CHECK: $r0 = JALR killed $r15, implicit $r1
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s32) = G_CONSTANT i32 1
    %3:_(s32) = G_ADD %0, %1
    %4:_(s32) = G_ADD %3, %2
    $r1 = COPY %4(s32)
    $r0 = JALR killed $r15, implicit $r1
...
