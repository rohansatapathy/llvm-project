# RUN: llc -march=lc2k -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s
--- |
  define void @f() { ret void }
...
---
name:            f
legalized:       false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
body:             |
  bb.0:
    liveins: $r1

    ; CHECK-LABEL: name: f
    ; CHECK: legalized: true
    ; CHECK: %0:_(p0) = COPY $r1
    ; CHECK: %1:_(s32) = G_LOAD %0(p0) :: (load (s32))
    ; CHECK: G_STORE %1(s32), %0(p0) :: (store (s32))
    ; CHECK: %2:_(p0) = G_LOAD %0(p0) :: (load (p0))
    ; CHECK: G_STORE %2(p0), %0(p0) :: (store (p0))
    %0:_(p0) = COPY $r1
    %1:_(s32) = G_LOAD %0(p0) :: (load (s32))
    G_STORE %1(s32), %0(p0) :: (store (s32))
    %2:_(p0) = G_LOAD %0(p0) :: (load (p0))
    G_STORE %2(p0), %0(p0) :: (store (p0))
...
