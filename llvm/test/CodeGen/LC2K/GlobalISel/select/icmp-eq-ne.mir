# RUN: llc -march=lc2k -run-pass=instruction-select -verify-machineinstrs %s -o - | FileCheck %s
--- |
  define i32 @eq(i32 %a, i32 %b) {
  entry:
    %c = icmp eq i32 %a, %b
    br i1 %c, label %t, label %f
  t:
    ret i32 1
  f:
    ret i32 0
  }
  define i32 @ne(i32 %a, i32 %b) {
  entry:
    %c = icmp ne i32 %a, %b
    br i1 %c, label %t, label %f
  t:
    ret i32 1
  f:
    ret i32 0
  }
...
---
name:            eq
legalized:       true
regBankSelected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: gprb }
  - { id: 1, class: gprb }
  - { id: 2, class: gprb }
  - { id: 3, class: gprb }
  - { id: 4, class: gprb }
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
body:             |
  bb.0.entry:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r1, $r2

    ; A same-block, single-use G_ICMP feeding directly into a G_BRCOND is
    ; fused into a single BEQ on the compared operands themselves, rather
    ; than materializing an intermediate 0/1 value via PSEUDO_CMP01 and
    ; branching on that. For eq, the fused BEQ branches straight to the
    ; BRCOND's true target.
    ; CHECK-LABEL: name: eq
    ; CHECK: BEQ %0, %1, %bb.1
    ; CHECK-NEXT: BEQ_UNCOND $r0, $r0, %bb.2
    %0:gprb(s32) = COPY $r1
    %1:gprb(s32) = COPY $r2
    %3:gprb(s32) = G_CONSTANT i32 0
    %4:gprb(s32) = G_CONSTANT i32 1
    %2:gprb(s1) = G_ICMP intpred(eq), %0(s32), %1
    G_BRCOND %2(s1), %bb.1
    G_BR %bb.2

  bb.1.t:
    $r1 = COPY %4(s32)
    $r0 = JALR killed $r15, implicit $r1

  bb.2.f:
    $r1 = COPY %3(s32)
    $r0 = JALR killed $r15, implicit $r1
...
---
name:            ne
legalized:       true
regBankSelected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: gprb }
  - { id: 1, class: gprb }
  - { id: 2, class: gprb }
  - { id: 3, class: gprb }
  - { id: 4, class: gprb }
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
body:             |
  bb.0.entry:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $r1, $r2

    ; For ne, the sense is inverted: the fused BEQ branches to the false
    ; target on equality, and the sibling unconditional branch is redirected
    ; to the true target.
    ; CHECK-LABEL: name: ne
    ; CHECK: BEQ %0, %1, %bb.2
    ; CHECK-NEXT: BEQ_UNCOND $r0, $r0, %bb.1
    %0:gprb(s32) = COPY $r1
    %1:gprb(s32) = COPY $r2
    %3:gprb(s32) = G_CONSTANT i32 0
    %4:gprb(s32) = G_CONSTANT i32 1
    %2:gprb(s1) = G_ICMP intpred(ne), %0(s32), %1
    G_BRCOND %2(s1), %bb.1
    G_BR %bb.2

  bb.1.t:
    $r1 = COPY %4(s32)
    $r0 = JALR killed $r15, implicit $r1

  bb.2.f:
    $r1 = COPY %3(s32)
    $r0 = JALR killed $r15, implicit $r1
...
