# RUN: llc -march=lc2k -run-pass=instruction-select -verify-machineinstrs %s -o - | FileCheck %s
--- |
  define i32 @f(i32 %a, i32 %b) {
    %c = icmp eq i32 %a, %b
    %s = sext i1 %c to i32
    ret i32 %s
  }
...
---
name:            f
legalized:       true
regBankSelected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: gprb }
  - { id: 1, class: gprb }
  - { id: 2, class: gprb }
  - { id: 3, class: gprb }
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
body:             |
  bb.0 (%ir-block.0):
    liveins: $r1, $r2

    ; G_SEXT from s1 is two's-complement negation of the canonical 0/1
    ; value: ~x via NAND(x,x) (NAND, not NOR, since not every LC2K variant
    ; has NOR), then +1.
    ; CHECK-LABEL: name: f
    ; CHECK: %2:gpr = PSEUDO_CMP01 %0, %1, 1
    ; CHECK-NEXT: [[NOT:%[0-9]+]]:gpr = NAND %2, %2
    ; CHECK-NEXT: %3:gpr = ADDI [[NOT]], 1
    ; CHECK-NEXT: $r1 = COPY %3
    %0:gprb(s32) = COPY $r1
    %1:gprb(s32) = COPY $r2
    %2:gprb(s1) = G_ICMP intpred(eq), %0(s32), %1
    %3:gprb(s32) = G_SEXT %2(s1)
    $r1 = COPY %3(s32)
    dead early-clobber %4:gpr = JALR killed $r15, implicit $r1
...
