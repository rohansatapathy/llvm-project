# RUN: llc -march=lc2k -run-pass=instruction-select -verify-machineinstrs %s -o - | FileCheck %s
--- |
  define i32 @f(i32 %n) {
  entry:
    br label %loop
  loop:
    %i = phi i32 [0, %entry], [%i2, %loop]
    %i2 = add i32 %i, 1
    %done = icmp eq i32 %i2, %n
    br i1 %done, label %exit, label %loop
  exit:
    ret i32 %i2
  }
...
---
name:            f
legalized:       true
regBankSelected: true
tracksRegLiveness: true
registers:
  - { id: 0, class: gprb }
  - { id: 1, class: gprb }
  - { id: 2, class: gprb }
  - { id: 3, class: gprb }
  - { id: 4, class: gprb }
  - { id: 5, class: gprb }
liveins:
  - { reg: '$r1', virtual-reg: '' }
body:             |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    liveins: $r1

    ; CHECK-LABEL: name: f
    ; G_BR always selects to the self-compare "always taken" idiom.
    ; CHECK: %0:gpr = COPY $r1
    ; CHECK: %2:gpr = ADDI $r0, 1
    ; CHECK: %5:gpr = ADDI $r0, 0
    ; CHECK: BEQ $r0, $r0, %bb.1
    %0:gprb(s32) = COPY $r1
    %2:gprb(s32) = G_CONSTANT i32 1
    %5:gprb(s32) = G_CONSTANT i32 0
    G_BR %bb.1

  bb.1.loop:
    successors: %bb.2(0x40000000), %bb.1(0x40000000)

    ; G_PHI just becomes a real PHI with its register constrained.
    ; CHECK: %1:gpr = PHI %5, %bb.0, %3, %bb.1
    ; CHECK: %3:gpr = ADD %1, %2
    ; G_ICMP eq/ne becomes a PSEUDO_CMP01 placeholder -- expanded into the
    ; real compare-and-branch + PHI sequence later by LC2KExpandPseudos,
    ; since GISel's InstructionSelect is itself mid-traversal of the CFG
    ; here and can't safely have its current block split.
    ; CHECK: %4:gpr = PSEUDO_CMP01 %3, %0, 1
    ; G_BRCOND fuses with the immediately-following G_BR: compare against
    ; zero to reach the false target, and the former G_BR is redirected
    ; from the false target to the true target.
    ; CHECK: BEQ %4, $r0, %bb.1
    ; CHECK: BEQ $r0, $r0, %bb.2
    %1:gprb(s32) = G_PHI %5(s32), %bb.0, %3(s32), %bb.1
    %3:gprb(s32) = G_ADD %1, %2
    %4:gprb(s1) = G_ICMP intpred(eq), %3(s32), %0
    G_BRCOND %4(s1), %bb.2
    G_BR %bb.1

  bb.2.exit:
    ; CHECK: $r1 = COPY %3
    ; CHECK: $r0 = JALR killed $r15, implicit $r1
    $r1 = COPY %3(s32)
    $r0 = JALR killed $r15, implicit $r1
...
