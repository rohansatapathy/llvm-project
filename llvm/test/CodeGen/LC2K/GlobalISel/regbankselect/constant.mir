# RUN: llc -march=lc2k -run-pass=regbankselect -verify-machineinstrs %s -o - | FileCheck %s
--- |
  define i32 @g() {
    ret i32 42
  }
...
---
name:            g
legalized:       true
tracksRegLiveness: true
registers:
  - { id: 0, class: _, preferred-register: '' }
body:             |
  bb.0 (%ir-block.0):
    ; CHECK-LABEL: name: g
    ; CHECK: %0:gprb(s32) = G_CONSTANT i32 42
    ; CHECK: $r1 = COPY %0(s32)
    ; CHECK: $r0 = JALR killed $r15, implicit $r1
    %0:_(s32) = G_CONSTANT i32 42
    $r1 = COPY %0(s32)
    $r0 = JALR killed $r15, implicit $r1
...
