# RUN: llc -march=lc2k -run-pass=regbankselect -verify-machineinstrs %s -o - | FileCheck %s
--- |
  define i32 @f(i32 %a, i32 %b) {
    %c = add i32 %a, %b
    ret i32 %c
  }
...
---
name:            f
legalized:       true
tracksRegLiveness: true
registers:
  - { id: 0, class: _, preferred-register: '' }
  - { id: 1, class: _, preferred-register: '' }
  - { id: 2, class: _, preferred-register: '' }
liveins:
  - { reg: '$r1', virtual-reg: '' }
  - { reg: '$r2', virtual-reg: '' }
body:             |
  bb.0 (%ir-block.0):
    liveins: $r1, $r2

    ; CHECK-LABEL: name: f
    ; CHECK: %0:gprb(s32) = COPY $r1
    ; CHECK: %1:gprb(s32) = COPY $r2
    ; CHECK: %2:gprb(s32) = G_ADD %0, %1
    ; CHECK: $r1 = COPY %2(s32)
    ; CHECK: $r0 = JALR killed $r15, implicit $r1
    %0:_(s32) = COPY $r1
    %1:_(s32) = COPY $r2
    %2:_(s32) = G_ADD %0, %1
    $r1 = COPY %2(s32)
    $r0 = JALR killed $r15, implicit $r1
...
